{
  "name": "opencode-browser-annotation-plugin",
  "version": "0.8.0",
  "description": "Select an element in your browser, type an instruction, and send it to your OpenCode agent over a loopback + SSH tunnel. Text and element metadata only (no screenshots).",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "browser",
    "annotation",
    "chrome-extension"
  ],
  "license": "MIT",
  "author": "Axenide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axenide/opencode-browser-annotation-plugin.git"
  },
  "type": "module",
  "main": "./src/plugin.ts",
  "module": "./src/plugin.ts",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "extension",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:ext": "node scripts/pack-extension.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.7"
  }
}
